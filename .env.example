POSTGRES_DB=cellier
POSTGRES_USER=cellier
POSTGRES_PASSWORD=changez-moi-avec-un-secret-long-et-aleatoire
CELLIER_PORT=8080
CELLIER_PUBLIC_URL=http://192.168.1.20:8080
CELLIER_ALLOWED_ORIGINS=
CELLIER_TRUSTED_PROXIES=127.0.0.1
CELLIER_LOG_LEVEL=INFO
# Sert à chiffrer les identifiants de fournisseurs en base.
CELLIER_ENCRYPTION_KEY=remplacez-par-un-second-secret-long-et-aleatoire

# Home Assistant — facultatif
CELLIER_HOME_ASSISTANT_URL=
CELLIER_HOME_ASSISTANT_TOKEN=
CELLIER_HOME_ASSISTANT_WEBHOOK_SECRET=

# Sauvegarde quotidienne, conservation 14 jours
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
